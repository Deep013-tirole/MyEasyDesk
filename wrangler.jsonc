{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myeasydesk",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "iconv-lite": "./src/shims/iconv-lite.cjs"
  },
  "vars": {
    "NODE_ENV": "production",
    "FIREBASE_STORAGE_BUCKET": "khaki-fact-snzsc.firebasestorage.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myeasydesk-prod-db",
      "database_id": "34b94cd2-634c-4563-b667-b41a4ae85568"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/uploads/*"
    ]
  }
}
